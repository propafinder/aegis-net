FROM rust:1-bookworm

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      iproute2 \
      iptables \
      tcpdump \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /aegis
COPY . /aegis
RUN cargo build -p aegis-measure --release

ENTRYPOINT ["/aegis/target/release/aegis-measure", "adversarial-runner"]
