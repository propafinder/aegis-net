[Unit]
Description=AEGIS AUTO terminal B after exact private stop %i
Requires=aegis-auto-guardian.service aegis-auto-terminal-observer.service
PartOf=aegis-auto@%i.service
After=aegis-auto-guardian.service aegis-auto-terminal-observer.service dbus.service dbus.socket
Before=aegis-auto@%i.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/python3 -I -B /usr/local/lib/aegis/helpers/lib/aegis_auto_terminal_witness.py bind %i
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
