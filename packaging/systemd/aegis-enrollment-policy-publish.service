[Unit]
Description=Publish a current enrollment policy without refreshing its lifetime

[Service]
Type=oneshot
User=root
Group=aegis-policy-export
UMask=0077
ExecStart=/usr/local/bin/aegis-server device-policy publish-staged --input /var/lib/aegis-device-policy-transfer/snapshot.json --registry /var/lib/aegis-device-authority/registry.json
StandardOutput=journal
StandardError=journal
TimeoutStartSec=20
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/aegis-device-authority
InaccessiblePaths=/var/lib/aegis-enrollment
