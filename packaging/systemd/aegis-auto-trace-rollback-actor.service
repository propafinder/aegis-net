[Unit]
Description=Aegis AUTO independent trace rollback actor
After=local-fs.target
ConditionPathExists=/usr/local/lib/aegis/helpers/lib/aegis_auto_trace_rollback.py

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/aegis/helpers/lib/aegis_auto_trace_rollback.py serve
RuntimeDirectory=aegis-auto-rollback
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
Restart=on-failure
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=6s

